POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<a-definir>

POSTGRES_DB_MAIN=emsc_main

POSTGRES_DB_USERS=emsc_users

POSTGRES_USER_APP=emsc
POSTGRES_PASSWORD_APP=<a-definir>

POSTGRES_USER_SECURE=secure
POSTGRES_PASSWORD_SECURE=<a-definir>


POSTGRES_USER_MIGR=migr
POSTGRES_PASSWORD_MIGR=<a-definir>

POSTGRES_HOST=db-main
POSTGRES_PORT=5432

POSTGRES_INITDB_ARGS=-c shared_preload_libraries=pg_stat_statements -c password_encryption=scram-sha-256
